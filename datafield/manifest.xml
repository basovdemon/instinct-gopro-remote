            <!-- Covers both Instinct 3 Solar 45mm and 50mm (partNumbers 006-B4585-00, 006-B4759-00) -->
            <iq:product id="instinct3solar45mm"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="BluetoothLowEnergy"/>
            <!-- gopro_recording field in the activity FIT file -->
            <iq:uses-permission id="FitContributor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>rus</iq:language>
        </iq:languages>
        <iq:barrels/>
